<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Bar with Title & Actions -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/library_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your Library"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold" />

        <ImageButton
            android:id="@+id/btn_import_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_glass"
            android:src="@drawable/ic_download"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="Import Playlist"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_create_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_glass"
            android:src="@drawable/ic_add"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/create_playlist"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="2.5dp"
        app:tabIndicatorAnimationMode="elastic"
        app:tabMode="fixed"
        app:tabRippleColor="@color/ripple_accent"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_secondary"
        app:tabTextAppearance="@style/LibraryTabTextAppearance">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playlists" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloads" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>