<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1F22"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationContentDescription="Back">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_play"
                    android:backgroundTint="@color/discord_blurple">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_discord"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Connect Discord"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Rich Presence Login"
                        android:textColor="#949BA4"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action: Reload -->
            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/white" />

            <!-- Action: Open in External Browser -->
            <ImageButton
                android:id="@+id/btn_open_browser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open in browser"
                android:padding="10dp"
                android:src="@drawable/ic_open_in_browser"
                app:tint="@color/white" />
        </androidx.appcompat.widget.Toolbar>

        <!-- Tab Selector: Web Login vs Enter Token -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#2B2D31"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/discord_blurple"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/white"
            app:tabTextAppearance="@style/TextAppearance.Discord.Tab"
            app:tabTextColor="#949BA4">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Web Login" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Token" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Web Loading Indicator -->
    <ProgressBar
        android:id="@+id/web_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/discord_blurple"
        android:visibility="gone" />

    <!-- Content Switcher -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── TAB 0: WEB LOGIN ── -->
        <FrameLayout
            android:id="@+id/container_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2B2D31"
            android:visibility="visible">

            <WebView
                android:id="@+id/webview_discord"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Error Banner (if offline) -->
            <LinearLayout
                android:id="@+id/container_web_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1E1F22"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_discord"
                    app:tint="#ED4245" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Failed to load Discord Login"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_web_error_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="Please check your internet connection."
                    android:textColor="#949BA4"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry_web"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/discord_blurple"
                    app:cornerRadius="21dp" />
            </LinearLayout>

            <!-- Bottom Security Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC1E1F22"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="🔒 Official discord.com login • Token captured automatically"
                android:textColor="#949BA4"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- ── TAB 1: DIRECT TOKEN ENTRY ── -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/container_token"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Direct Token Authorization"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingExtra="3dp"
                    android:text="If you already have your Discord user authorization token, paste it below to instantly enable Rich Presence."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Token Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/token_input_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/discord_blurple"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_secondary"
                    app:hintTextColor="@color/discord_blurple">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_discord_token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:hint="Discord User Token"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="3"
                        android:paddingVertical="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Clipboard Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_paste_token"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="📋 Paste from Clipboard"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="#2B2D31"
                    app:cornerRadius="19dp" />

                <!-- Status / Error -->
                <TextView
                    android:id="@+id/tv_token_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#FF453A"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Connect Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_connect"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Verify &amp; Connect"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@color/discord_blurple"
                    app:cornerRadius="25dp" />

                <!-- Explanatory Guide Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="💡 Recommended: Use Web Login Tab"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins"
                            android:lineSpacingExtra="3dp"
                            android:text="The Web Login tab allows you to log in directly via discord.com (including QR code login). Once logged in, Midnight automatically extracts your authorization token without requiring developer tools."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</LinearLayout>
