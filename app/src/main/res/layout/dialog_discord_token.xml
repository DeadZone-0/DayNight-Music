<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:padding="24dp"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_dialog">

    <!-- Header with Discord Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_play"
            android:backgroundTint="#2B2D31">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_discord"
                app:tint="@color/discord_blurple" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect Discord"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rich Presence Authorization"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="Paste your Discord User Token to broadcast live music activity directly to your Discord profile."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="2dp" />

    <!-- Token Input Layout -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/token_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="@color/discord_blurple"
        app:boxBackgroundColor="@color/card_background"
        app:hintTextColor="@color/discord_blurple"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/text_secondary"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_discord_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Discord User Token"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:fontFamily="@font/poppins"
            android:textSize="13sp"
            android:paddingVertical="14dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Paste Clipboard Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_paste_token"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="📋 Paste from Clipboard"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_medium"
        app:backgroundTint="#2B2D31"
        app:cornerRadius="18dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

    <!-- Status / Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_verifying"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/discord_blurple"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_verify_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF453A"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_semibold"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_connect"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Connect"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_semibold"
            android:textAllCaps="false"
            app:backgroundTint="@color/discord_blurple"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
