<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="120dp">

        <!-- Header with greeting and icons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_home_header"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/greeting_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_notifications"
                app:layout_constraintEnd_toStartOf="@id/btn_history"
                app:layout_constraintTop_toTopOf="@id/greeting_text"
                app:layout_constraintBottom_toBottomOf="@id/greeting_text"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="History"
                android:src="@drawable/ic_history"
                app:layout_constraintEnd_toStartOf="@id/btn_settings"
                app:layout_constraintTop_toTopOf="@id/greeting_text"
                app:layout_constraintBottom_toBottomOf="@id/greeting_text"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/greeting_text"
                app:layout_constraintBottom_toBottomOf="@id/greeting_text"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/user_greeting_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Discover your perfect sound"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins_medium"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/greeting_text" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Animeze Promotion Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_animeze_promo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#131316"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <!-- Animeze Icon -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_animeze_promo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Album" />

                <!-- Text Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Animeze"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="#26FFFFFF"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="FREE APP"
                            android:textColor="#B3FFFFFF"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:text="Stream anime ad-free in 1080p • Tap to open"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Explore / Get Button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Open"
                    android:textColor="@color/black"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Featured Hero Spotlight Banner (Animeze Signature) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_spotlight_card"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Background Cover Image with Gradient Vignette -->
                <ImageView
                    android:id="@+id/hero_backdrop_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_album" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_hero_overlay" />

                <!-- Left Content: Badge, Title, Artist -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/hero_play_btn"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/hero_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="✦ SPOTLIGHT"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/hero_song_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:text="Believer"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/hero_song_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:text="Imagine Dragons"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Floating Play Button Circle -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/hero_play_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    app:fabSize="normal"
                    app:backgroundTint="@color/white"
                    app:tint="@color/black"
                    android:src="@drawable/ic_play"
                    app:elevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Your playlists section (Grid) -->
        <TextView
            android:id="@+id/recent_playlists_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="Your playlists"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:id="@+id/recent_playlists_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:text="Your most listened playlists"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/shimmer_playlists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_shimmer_card" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_shimmer_card" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_shimmer_card" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="6dp" android:background="@drawable/bg_shimmer_card" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_playlists_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"
                tools:itemCount="4"
                tools:listitem="@layout/item_playlist_tile" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Recently played section (compact) -->
        <TextView
            android:id="@+id/recently_played_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="Recently played"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_bold" />

        <LinearLayout
            android:id="@+id/shimmer_recently_played"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">
            <View android:layout_width="140dp" android:layout_height="180dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_shimmer_card" />
            <View android:layout_width="140dp" android:layout_height="180dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_shimmer_card" />
            <View android:layout_width="140dp" android:layout_height="180dp" android:background="@drawable/bg_shimmer_card" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recently_played_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:itemCount="5"
            tools:listitem="@layout/item_recent_compact" />

        <!-- Recommended for you section -->
        <TextView
            android:id="@+id/recommended_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:text="Recommended for you"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:id="@+id/recommended_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:text="Based on what you listen to"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins" />

        <LinearLayout
            android:id="@+id/shimmer_recommended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal">
            <View android:layout_width="176dp" android:layout_height="220dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_shimmer_card" />
            <View android:layout_width="176dp" android:layout_height="220dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_shimmer_card" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommended_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            tools:itemCount="5"
            tools:listitem="@layout/item_song_card" />

        <TextView
            android:id="@+id/recommended_empty_text"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Keep listening to get recommendations"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_medium"
            android:visibility="gone" />

        <!-- Trending section -->
        <TextView
            android:id="@+id/new_releases_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:text="Trending Now"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:id="@+id/new_releases_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:text="What everyone is listening to"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins" />

        <LinearLayout
            android:id="@+id/shimmer_new_releases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="100dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal">
            <View android:layout_width="176dp" android:layout_height="220dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_shimmer_card" />
            <View android:layout_width="176dp" android:layout_height="220dp" android:layout_marginHorizontal="8dp" android:background="@drawable/bg_shimmer_card" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/new_releases_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="100dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            tools:itemCount="5"
            tools:listitem="@layout/item_song_card" />
            
        <LinearLayout
            android:id="@+id/trending_error_state"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="100dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No internet connection"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>