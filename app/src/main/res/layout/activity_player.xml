<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0D11"
    android:fitsSystemWindows="true"
    android:transitionGroup="true">

    <!-- Blurred background image overlay -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient overlay for subtle dark room depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_fade_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- TOP BAR: Chevron + "NOW PLAYING" + Queue + Options -->
    <!-- ═══════════════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_down_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtNowPlayingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.16"
            android:text="@string/now_playing"
            android:textAllCaps="true"
            android:textColor="#A0FFFFFF"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topBarActions"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/topBarActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnShowQueue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/queue"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnOptions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/options"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!-- ALBUM ART SECTION (Fluidly scales on any screen height) -->
    <!-- ═══════════════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/albumArtContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintHeight_max="310dp"
        app:layout_constraintWidth_max="310dp"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout"
        app:layout_constraintBottom_toTopOf="@id/songInfoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Vinyl disc peeking behind album art -->
        <ImageView
            android:id="@+id/imgVinylDisc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="36dp"
            android:alpha="0.85"
            android:src="@drawable/bg_vinyl_disc"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.94"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.85" />

        <!-- Main Album Art -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAlbumArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="8dp"
            android:scaleType="centerCrop"
            android:transitionName="transition_album_art"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.96"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.25"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Album.Player" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SONG INFO: Title, Artist, Like Button        -->
    <!-- ═══════════════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/songInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer">

        <TextView
            android:id="@+id/txtSongName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/poppins_semibold"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:transitionName="transition_song_title"
            app:layout_constraintBottom_toTopOf="@id/txtArtistName"
            app:layout_constraintEnd_toStartOf="@id/btnLike"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Blinding Lights" />

        <TextView
            android:id="@+id/txtArtistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:textColor="#9E9EA8"
            android:textSize="13sp"
            android:transitionName="transition_artist_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnLike"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSongName"
            tools:text="The Weeknd • After Hours" />

        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/like"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════ -->
    <!-- PLAYBACK CONTROLS & ACTION DOCK              -->
    <!-- ═══════════════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Progress SeekBar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingVertical="10dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/bg_seekbar_track"
            android:thumb="@drawable/bg_seekbar_thumb"
            android:thumbTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#7A7A85"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/seekBar"
            app:layout_constraintTop_toBottomOf="@id/seekBar"
            tools:text="1:24" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#7A7A85"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/seekBar"
            app:layout_constraintTop_toBottomOf="@id/seekBar"
            tools:text="3:42" />

        <!-- ════════════════════════════════════ -->
        <!-- MAIN TRANSPORT ROW                  -->
        <!-- ════════════════════════════════════ -->

        <LinearLayout
            android:id="@+id/additionalControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/txtCurrentTime">

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shuffle"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shuffle_rounded"
                app:tint="@color/gray_light" />

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_prev_rounded"
                app:tint="@color/white" />

            <!-- Circular Play/Pause button -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="16dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/play_pause"
                    android:scaleType="center"
                    android:transitionName="transition_play_button"
                    app:backgroundTint="@color/white"
                    app:borderWidth="0dp"
                    app:elevation="4dp"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="30dp"
                    app:tint="#0C0D11" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_next_rounded"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/repeat"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_repeat_rounded"
                app:tint="@color/gray_light" />

        </LinearLayout>

        <!-- ════════════════════════════════════ -->
        <!-- SECONDARY ACTION DOCK (tactile pill row) -->
        <!-- ════════════════════════════════════ -->

        <LinearLayout
            android:id="@+id/extraControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_player_dock"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            app:layout_constraintTop_toBottomOf="@id/additionalControlsContainer">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnDownload"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Download"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_download_arrow"
                    app:tint="#B3FFFFFF" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="#B3FFFFFF"
                    app:indicatorSize="22dp"
                    app:trackThickness="2dp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnAddToPlaylist"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/add_to_playlist"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_playlist_add"
                app:tint="#B3FFFFFF" />

            <ImageButton
                android:id="@+id/btnLyrics"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show lyrics"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lyrics"
                app:tint="#B3FFFFFF" />

            <ImageButton
                android:id="@+id/btnSimilarSongs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add similar songs"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_magic_mix"
                app:tint="#B3FFFFFF" />

            <ImageButton
                android:id="@+id/btnSleepTimer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sleep timer"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sleep_timer"
                app:tint="#B3FFFFFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════ -->
    <!-- LYRICS PANEL (Overlay over middle section) -->
    <!-- ══════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyricsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/bg_lyrics_panel"
        android:elevation="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout">

        <!-- Top Drag Pill -->
        <View
            android:id="@+id/lyricsDragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#4DFFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lyrics Header Bar -->
        <LinearLayout
            android:id="@+id/lyricsHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/btnCloseLyrics"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyricsDragHandle">

            <TextView
                android:id="@+id/lyricsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.06"
                android:text="LYRICS"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lyricsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:text="Synchronized playback"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseLyrics"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="Close lyrics"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="@id/lyricsHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lyricsHeader"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtLyricsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyricsHeader" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lyricsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="64dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="64dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyricsHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════ -->
    <!-- QUEUE PANEL (Slide-up bottom sheet) -->
    <!-- ══════════════════════════════════ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/queueContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_rounded_top_corners"
        android:backgroundTint="#FA12131A"
        android:elevation="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout">

        <!-- Drag handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:alpha="0.45"
            android:background="@drawable/bg_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/queueTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Up Next"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dragHandle" />

        <ImageButton
            android:id="@+id/btnCloseQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_queue"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="@id/queueTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/queueTitle"
            app:tint="@color/white" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="#14FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/queueTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:listitem="@layout/item_queue_song" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>